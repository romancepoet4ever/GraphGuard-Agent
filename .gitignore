"""
Git忽略文件
"""
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
dist/
*.egg-info/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# 环境变量
.env

# 日志
logs/
*.log

# 临时文件
*.tmp
temp/
tmp/

# 模型文件
*.pth
*.bin
*.h5

# 数据
data/attack_samples/*.json
data/benign_traces/*.json

# 测试
.pytest_cache/
.pytest-temp/
.coverage
htmlcov/

# Local runtime state (keep public fixtures under data/demo_traces)
data/trace_store/*.sqlite*
data/generic_plugin_traces/
data/audit_logs/audit_*.json

# SQLite 边车文件（WAL 模式打开 .sqlite 时自动生成，不入库）
*.sqlite-wal
*.sqlite-shm

# 本地工具链（如 lark-cli 二进制），不入库
.tools/

# OS
.DS_Store
Thumbs.db
