# ============================================================
# GraphGuard-Agent 环境变量模板
# ============================================================
# 用法：复制为 .env 后按需修改。`.env` 已在 .gitignore 中，不会被提交。
#     Windows:      copy .env.example .env
#     macOS/Linux:  cp .env.example .env
#
# 与 env.live.example 的关系：
#   - .env.example       本模板，覆盖"服务端 + SDK 接入"两类变量，面向本地开发与自测
#   - env.live.example   面向"中间件独立部署 + 业务应用接入"的最小集合
#   两者都只是模板，实际生效的是 .env 或进程环境变量。
#
# 所有变量都有默认值：不创建 .env 也能启动，此时报告生成走 provider=mock。

# ===== 服务 =====
API_HOST=127.0.0.1
API_PORT=8001
DEBUG=false

# ===== 存储与日志 =====
# SQLite 文件在首次启动时自动创建于 data/trace_store/ 下，无需手动初始化
DATA_DIR=data
LOG_DIR=logs

# ===== SDK / 接入侧（业务应用读取）=====
GRAPHGUARD_API_URL=http://127.0.0.1:8001
GRAPHGUARD_CONSOLE_URL=http://127.0.0.1:5174
# 留空表示不做请求级鉴权；生产环境应设置为强随机值
GRAPHGUARD_API_KEY=
# observe（只观测） | enforce（按策略阻断/脱敏）
GRAPHGUARD_MODE=observe
GRAPHGUARD_FAIL_OPEN=true
GRAPHGUARD_TRACE_DIR=data/security_traces
GRAPHGUARD_REQUEST_TIMEOUT=5.0
GRAPHGUARD_BATCH_SIZE=20
GRAPHGUARD_FLUSH_INTERVAL_MS=200

# ===== 隐私采集档位 =====
# metadata_only（仅元数据） | redacted（默认，敏感字段脱敏） | full（原文）
GRAPHGUARD_CAPTURE_MODE=redacted
GRAPHGUARD_RAW_CONTENT=false
GRAPHGUARD_POLICY_PACK=generic_default

# ===== 模型 Provider =====
# 不配置任何密钥时，报告生成使用 provider=mock：无需联网、可离线演示全部检测能力。
# 需要真实模型时取消注释并填写对应变量。
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=minimax/minimax-m2.1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ===== 检测阈值 =====
GRAPH_ANOMALY_THRESHOLD=0.3
NODE_RISK_THRESHOLD=0.7
